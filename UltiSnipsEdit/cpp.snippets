snippet std "Import cout" b
#include <algorithm>
#include <iostream>
#include <limits>
#include <span>
#include <vector>
using std::cerr;
using std::cout;
using std::endl;
using std::vector;
template <class T>
auto print_vec(
  const vector<T> &v, uint64_t limit = std::numeric_limits<uint64_t>::max()
) {
  cout << "---------------------" << endl;
  for (int i = 0; i < std::min(limit, v.size()); ++i) {
    cout << v[i] << " "; }
  cout << endl << "---------------------" << endl;
}

endsnippet

snippet stdio "Import cout2" b
#include <iostream>
